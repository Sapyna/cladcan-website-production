                                    <g transform="translate(-1329.000000, -346.000000)" fill="#6F00FF" fill-rule="nonzero">
                                        <g transform="translate(1007.000000, 62.000000)">
                                            <path d="M334.747741,296.747741 C331.831519,299.663964 327.103389,299.663964 324.187167,296.747741 C321.270944,293.831519 321.270944,289.103389 324.187167,286.187167 C327.103389,283.270944 331.831519,283.270944 334.747741,286.187167 C337.663964,289.103389 337.663964,293.831519 334.747741,296.747741 Z M332.635626,294.635626 C334.38536,292.885893 334.38536,290.049015 332.635626,288.299282 C330.885893,286.549548 328.049015,286.549548 326.299282,288.299282 C324.549548,290.049015 324.549548,292.885893 326.299282,294.635626 C328.049015,296.38536 330.885893,296.38536 332.635626,294.635626 Z M354.812833,316.812833 C351.896611,319.729056 347.168481,319.729056 344.252259,316.812833 C341.336036,313.896611 341.336036,309.168481 344.252259,306.252259 C347.168481,303.336036 351.896611,303.336036 354.812833,306.252259 C357.729056,309.168481 357.729056,313.896611 354.812833,316.812833 Z M352.700718,314.700718 C354.450452,312.950985 354.450452,310.114107 352.700718,308.364374 C350.950985,306.61464 348.114107,306.61464 346.364374,308.364374 C344.61464,310.114107 344.61464,312.950985 346.364374,314.700718 C348.114107,316.450452 350.950985,316.450452 352.700718,314.700718 Z M327.980031,315.228964 C327.348173,314.698772 327.26552,313.757026 327.796615,313.124092 L348.915224,287.955914 C349.445784,287.323617 350.383705,287.237148 351.019969,287.771036 C351.651827,288.301228 351.73448,289.242974 351.203385,289.875908 L330.084776,315.044086 C329.554216,315.676383 328.616295,315.762852 327.980031,315.228964 Z"></path>
                                        </g>
                                    </g>
                                </g>
                            </svg>`;
        const timer = `<svg width="35px" height="35px" viewBox="0 0 35 35" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                              <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                  <g transform="translate(-1331.000000, -573.000000)" fill="#6F00FF" fill-rule="nonzero">
                                      <g transform="translate(1007.000000, 62.000000)">
                                          <g transform="translate(324.000000, 511.000000)">
                                              <path d="M15.2658333,17.8763148 C15.2903333,17.9066481 15.3241667,17.9334815 15.351,17.9626481 C15.694,18.3919815 16.2108333,18.6708148 16.8,18.6708148 C17.8301667,18.6708148 18.6666667,17.8296481 18.6666667,16.7878148 C18.6666667,16.2348148 18.4251667,15.7436481 18.0518333,15.3994815 C18.0028333,15.3446481 17.9585,15.2886481 17.8861667,15.2338148 L10.3436667,9.44481481 C10.1243333,9.27448148 9.80816667,9.26514815 9.57833333,9.44481481 C9.303,9.65831481 9.25166667,10.0561481 9.46283333,10.3314815 L15.2658333,17.8763148 Z M17.5,0.00414814815 C17.2701667,0.00414814815 16.5596667,-0.00518518519 16.3333333,0.00414814815 L16.3333333,8.17081481 L18.6666667,8.17081481 L18.6666667,2.19164815 C25.9805,2.16131481 32.6666667,8.86381481 32.6666667,17.5041481 C32.6666667,26.3801481 26.3771667,32.6708148 17.5,32.6708148 C8.62166667,32.6708148 2.33333333,26.3801481 2.33333333,17.5041481 C2.33333333,13.0638148 3.717,9.54981481 6.6325,6.63548148 L5.1275,5.12931481 C1.95883333,8.29564815 0,12.6706481 0,17.5041481 C0,27.1676481 7.83416667,35.0018148 17.5,35.0018148 C27.1658333,35.0018148 35,27.1676481 35,17.5041481 C35,7.84064815 27.1658333,0.00414814815 17.5,0.00414814815 Z"></path>
                                          </g>
                                      </g>
                                  </g>
                              </g>
                          </svg>`;
        return `<div>
             <div class="adlmodal_title">Page information</div>
             <div class="adlmodal_c">
               <div>
                 <div class="adlmodal_c_period">${prevPeriod}</div>
                 <div class="adlmodal_p_info">
                   <div>
                     ${eye}
                   </div>
                   <div>
                     <div class="adlmodal_c_value">${prevVisits}</div>
                     <div class="adlmodal_c_title">Unique visitors</div>
                   </div>
                 </div>
                 <div class="adlmodal_p_info">
                   <div>
                     ${percent}
                   </div>
                   <div>
                     <div class="adlmodal_c_value">${prevConv}%</div>
                     <div class="adlmodal_c_title">Conversion rate</div>
                   </div>
                 </div>
                 <div class="adlmodal_p_info">
                   <div>
                     ${eyeClosed}
                   </div>
                   <div>
                     <div class="adlmodal_c_value">${prevDropOff}%</div>
                     <div class="adlmodal_c_title">Drop off rate</div>
                   </div>
                 </div>
                 <div class="adlmodal_p_info">
                   <div>
                     ${timer}
                   </div>
                   <div>
                     <div class="adlmodal_c_value">${prevTime}</div>
                     <div class="adlmodal_c_title">Time on page</div>
                   </div>
                 </div>
               </div>

               <div class="adlmodal_f_separator page-info-separator">
                 <div class="adlmodal_separator">
                   vs
                 </div>
               </div>

               <div>
                 <div class="adlmodal_c_period">${currPeriod}</div>
                 <div class="adlmodal_p_info">
                   <div>
                     ${eye}
                   </div>
                   <div>
                     <div class="adlmodal_c_value">${currVisits}</div>
                     <div class="adlmodal_c_title">Unique visitors</div>
                   </div>
                 </div>
                 <div class="adlmodal_p_info">
                   <div>
                     ${percent}
                   </div>
                   <div>
                     <div class="adlmodal_c_value">${currConv}%</div>
                     <div class="adlmodal_c_title">Conversion rate</div>
                   </div>
                 </div>
                 <div class="adlmodal_p_info">
                   <div>
                     ${eyeClosed}
                   </div>
                   <div>
                     <div class="adlmodal_c_value">${currDropOff}%</div>
                     <div class="adlmodal_c_title">Drop off rate</div>
                   </div>
                 </div>
                 <div class="adlmodal_p_info">
                   <div>
                     ${timer}
                   </div>
                   <div>
                     <div class="adlmodal_c_value">${currTime}</div>
                     <div class="adlmodal_c_title">Time on page</div>
                   </div>
                 </div>
               </div>
             </div>
             <div class="adlmodal_action">
               <a href="${window.adlineConfig.clientProdUrl}tracking/pages?pageUrl=${helpers.getUrlForTrackingInfo()}&startDate=${filter.startDate}&endDate=${filter.endDate}&value=${filter.value}&granularity=${filter.granularity}&period=${filter.period}" target="_blank">See more</a>
             </div>
           </div>`;
      }

      function setPreviewPosition(preview) {
        if (preview) {
          preview.style.opacity = 0;
          preview.style.display = 'inline-block';

          const {offsetHeight} = preview;
          const {height, width, top} = document.querySelector('.frame-info-page-button').getBoundingClientRect();
          preview.style.right = width + 20 + 'px';
          const topPoss = (top - offsetHeight / 2) + (height / 2);
          preview.style.top = (topPoss < 0 ? 0 : (top - offsetHeight / 2) + (height / 2)) + 'px';
          preview.style.opacity = 1;
        }
      }

      let clickPageInfo = false;

      document.addEventListener('click', (ev) => {
        let el = ev.target;
        const preview = document.querySelector('.adlmodal-page');
        if (el.getAttribute('class') === 'info-page-button') {
          clickPageInfo = true;
          setPreviewPosition(preview);

          preview.innerHTML = helpers.setLoadingHtml();
          setPreviewPosition(preview);

          helpers.getPageInfo((res) => {
            const currVisits = res.uniqueVisitors[0] || 0;
            const currConv = helpers.getConversion(
              res.uniqueVisitors[0] || 0,
              res.allUniqueVisitors[0] || 0
            );
            const currDropOff = res.pageDropoff[0] ? (Math.round(res.pageDropoff[0] * 10000) / 100) : 0;
            const currTime = helpers.secondsToStringTime(res.pagePerformanceAverageTime[0]);

            const prevVisits = res.uniqueVisitors[1] || 0;
            const prevConv = helpers.getConversion(
              res.uniqueVisitors[1] || 0,
              res.allUniqueVisitors[1] || 0
            );
            const prevDropOff = res.pageDropoff[1] ? (Math.round(res.pageDropoff[1] * 10000) / 100) : 0;
            const prevTime = helpers.secondsToStringTime(res.pagePerformanceAverageTime[1]);

            preview.innerHTML = getPageInfoTemplate(prevVisits, prevConv, prevDropOff, prevTime, currVisits, currConv, currDropOff, currTime);
            setPreviewPosition(preview);
          })
        } else {
          if (clickPageInfo && !document.querySelector('.adlmodal-page').contains(el)) {
            clickPageInfo = false;
            preview.style.opacity = 0;
            preview.style.display = 'none';
          }
        }
      })
    })(window, document);
  }
})(window, document);

(function runTracking(window, document) {
  if (!window.adlineConfig.clickMapMode) {
    (function eventListener(window, document) {
      const helpers = window.adlineConfig.helpers;
      const EL_TYPE = {
        BUTTON: 'b',
        A: 'l',
        INPUT: 'b',
        CUSTOM: 'c',
      };
      const INPUT_TYPES = ['button', 'submit'];

      function checkElement(el) {
        let count = 5;
        let payload = null;

        function getElement(el) {
          while (count > 0) {
            let customClick = null;
            try {
              customClick = el.getAttribute('data-adline-click');
            } catch (e) {
              customClick = null;
            }
            if (
              customClick ||
              el.tagName === 'BUTTON' ||
              el.tagName === 'A' ||
              (el.tagName === 'INPUT' && INPUT_TYPES.includes(el.type))
            ) {
              let name = (customClick || el.textContent || el.getAttribute('value') || '').trim();

              let img = '';
              if (!name) {
                const innerImg = el.querySelector('img');
                if (innerImg) {
                  img = innerImg.getAttribute('src');
                  if (!img) {
                    const alt = innerImg.getAttribute('alt');
                    if (alt) {
                      name = alt;
                    }
                  }
                }
              }

              payload = {
                e: 'c',
                xpath: helpers.getXPathElement(el),
                l: el.href || '',
                t: EL_TYPE[customClick ? 'CUSTOM' : el.tagName],
                n: name,
                cid: helpers.getCustomerId(),
                c: helpers.getVisitorId(),
                sid: helpers.getSessionId(),
                ts: helpers.getTime(),
                meta: helpers.getBrowser(),
                tz: helpers.getTimezoneOffset(),
                lndcAttr: helpers.getInitAttr(),
                url: helpers.getUrl(),
                campId: helpers.getCampaignId(),
                gclid: helpers.getGclid(),
                fbclid: helpers.getFbclid(),
                adId: helpers.getAdId(),
                chId: helpers.getChannelId(),
                img
              };
              count = 0;
            } else if (el.parentNode) {
              getElement(el.parentNode);
            } else {
              count = 0;
            }
            --count;
          }
        }

        getElement(el);
        return payload;
      }

      document.addEventListener('click', function (ev) {
        const payload = checkElement(ev.target);

        if (payload) {
          helpers.sendBeaconToServer(payload);
        }
      });
    })(window, document);

    (function addPixelTags(window) {
      const helpers = window.adlineConfig.helpers;

      const facebook_pixel_script_code = window.adlineConfig.fbPixelConfig.facebook_pixel_script_code;
      if (facebook_pixel_script_code) {
        helpers.addDynamicTag({
          name: 'script',
          content: facebook_pixel_script_code
        });
      }

      const facebook_pixel_noscript_code = window.adlineConfig.fbPixelConfig.facebook_pixel_noscript_code;
      if (facebook_pixel_noscript_code) {
        helpers.addDynamicTag({
          name: 'noscript',
          content: '<img height="1" width="1" style="display:none" src=" ' + facebook_pixel_noscript_code + '"/>'
        });
      }

      const google_async_code = window.adlineConfig.googlePixelConfig.google_async_code
      if (google_async_code) {
        helpers.addDynamicTag({
          name: 'script',
          async: true,
          src: google_async_code
        });
      }

      const google_script_code = window.adlineConfig.googlePixelConfig.google_script_code
      if (google_script_code) {
        helpers.addDynamicTag({
          name: 'script',
          content: google_script_code.replace('\\', '') // delete the screenplay symbol
        });
      }

      const domain_validate_facebook_meta = window.adlineConfig.fbPixelConfig.domain_validate_facebook_meta;
      if (domain_validate_facebook_meta)
        helpers.addFacebookMetaTag({
          tag: 'meta',
          name: domain_validate_facebook_meta.name,
          content: domain_validate_facebook_meta.content
        });
    })(window);
  }

  (function loadListener(window, document) {
    const helpers = window.adlineConfig.helpers;

    window.addEventListener('load', function () {
      if (document.visibilityState === 'visible') {
        helpers.checkStepTransitions();
        helpers.sendLoad();
      }
    });
  })(window, document);

  (function unloadListener(window, document) {
    const helpers = window.adlineConfig.helpers;

    document.addEventListener('visibilitychange', function () {
      const visibilityState = document.visibilityState;
      if (visibilityState === 'visible') {
        helpers.sendLoad();
      } else {
        helpers.sendUnLoad();
      }
    });

    window.addEventListener('onurlchanged', function (e) {
      helpers.checkStepTransitions();
      helpers.sendUnLoad(e.detail.oldURL);
      helpers.sendLoad(e.detail.newURL);
    });
  })(window, document);

})(window, document);


