      const currPeriod = `${helpers.getDateToString(filter.startDate)} - ${helpers.getDateToString(filter.endDate)}`
      const prevPeriod = `${helpers.getDateToString(filter.prevStartDate)} - ${helpers.getDateToString(filter.prevEndDate)}`

      function getButtonInfoTemplate(name, prevClicks, prevConv, currClicks, currConv) {
