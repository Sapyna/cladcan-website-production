
(function () {
  window.adlineConfig = {
    domain: '.maibec.com',
    serverUrl: 'https://t.adline.com/track.php',
    trackingUrl: 'https://t.adline.com/stats',
    clientProdUrl: 'https://prod.adline.com/',
    customerId: 'LGk5ixWzuNTCG4n0TGbQ',
    heatmapUrl: 'https://t.adline.com/heatmap',
    startTime: Date.now(),
    googlePixelConfig: {
      google_async_code: "",
      google_script_code: ""
    },
    fbPixelConfig: {
      facebook_pixel_script_code: "",
      facebook_pixel_noscript_code: "",
      domain_validate_facebook_meta: null
    },
    duration: {
      adl_session_id: 30 * 60, // in sec
      adl: 365 * 24 * 60 * 60, // visitorId in sec
      lndcAttr: 30 * 24 * 60 * 60, // in sec
    },
    generatedElements: new Set(),
    clickMapMode: false
  };
})();

(function urlListener(window) {
  const location = window.location;

  let oldPathname = location.pathname;
  let oldURL = location.href;

  setInterval(function () {
    const newPathname = location.pathname;
    const newURL = location.href;
    if (oldPathname !== newPathname) {
      const event = new CustomEvent('onurlchanged', {
        detail: {
          oldURL: oldURL,
          newURL: newURL,
        },
      });
      window.dispatchEvent(event);
      oldPathname = newPathname;
      oldURL = newURL;
    }
  }, 300);
})(window);

(function adlineHelpers(window) {

  function getConversion(value1, value2) {
    const value = +value2 ? +value1 / +value2 : 0;
    return value ? (Math.round((value * 10000)) / 100) : value;
  }

  function getDevice() {
    const ua = navigator.userAgent;
    const mobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(ua) && 'M';
    const tablet = /Tablet|iPad/i.test(ua) && 'T';
    return tablet || mobile || 'D';
  }

  function getTime() { // in seconds
    return Math.round(Date.now() / 1000);
  }

  function getDateToString(sec) {
    const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    const dateObj = new Date(sec * 1000);
    const month = monthNames[dateObj.getMonth()];
    const day = dateObj.getDate();
    const year = dateObj.getFullYear();
    return day + ' ' + month;
  }

  function getHeatMapFilter() {
    const data = sessionStorage.getItem('adl_heat_map');
    return data && JSON.parse(data);
  }

  function setCookie(name, value, days = 30) {
    const date = new Date();
    date.setTime(date.getTime() + (window.adlineConfig.duration[name] || days * 24 * 60 * 60) * 1000);
    const expires = date.toUTCString();
    const data = typeof value === "object" ? JSON.stringify(value) : '' + value;
    document.cookie = name + '=' + data + '; expires' + expires + '; path=/; domain=' + (window.adlineConfig.domain || '');
    return data;
  }

  function getCookie(name, load = false) {
    const nameEQ = name + '=';
    const ca = document.cookie.split(';');
    for (let c of ca) {
      while (c.charAt(0) === ' ') {
        c = c.substring(1, c.length);
      }
      if (c.indexOf(nameEQ) === 0) {
        let value = c.substring(nameEQ.length, c.length);
        try {
          value = JSON.parse(value);
        } catch (e) {
        }
        if (load) {
          setCookie(name, value);
        }
        return value;
      }
    }
    return null;
  }

  function deleteCookie(name) {
    document.cookie = `${name}=;path=/;domain=.${(window.adlineConfig.domain || '')};expires=Thu, 01 Jan 1970 00:00:01 GMT`;
  }

  function checkStepTransitions() {
    const filter = getHeatMapFilter();
    if (filter) {
      if (filter.cst && filter.cst.length === 1) {
        sessionStorage.removeItem('adl_heat_map');
        const el = document.createElement('div');
        el.className = 'click-map-window-frame';
        el.innerHTML = `<div class="click-map-window-modal">
            <h1>Warning</h1>
            <p>To get more click map pages you need to upgrade your plan.</p>
            <div class="click-map-actions">
              <button onclick="window.location.reload()">Cancel</button>
              <a href="${filter.appsumo ? ('https://' + filter.appsumo) : (window.adlineConfig.clientProdUrl + 'company?upgrade=true') }">Upgrade plan</a>
            </div>
          </div>`
        document.body.appendChild(el);
      } else {
        if (filter.cst) {
          sessionStorage.setItem('adl_heat_map', JSON.stringify({
            ...filter,
            cst: filter.cst.slice(1),
          }))
        }
      }
    }
  }

  function getTimezoneOffset() {
    return new Date().getTimezoneOffset() * 60;
  }

  function ajax(options, callback) {
    const xHttp = new XMLHttpRequest();
    xHttp.onreadystatechange = function () {
      if (xHttp.readyState === 4) {
        if (callback) {
          if (xHttp.status === 200) {
            const response = JSON.parse(xHttp.response);
            callback(options.objToResponse ? {...response, ...options.objToResponse} : response);
          } else {
            callback(null, xHttp.response);
          }
        }
      }
    };

    xHttp.open(options.method, options.url, true);

    if (options.headers) {
      for (const headerKey in options.headers) {
        xHttp.setRequestHeader(headerKey, options.headers[headerKey]);
      }
    } else {
      xHttp.setRequestHeader('Content-type', 'application/json');
    }

    xHttp.send(options.body || undefined);
  }

  function sendToServer(body, callback) {
    if (!body.c || !body.sid) {
      return;
    }
    ajax(
      {
        url: window.adlineConfig.serverUrl,
        body: JSON.stringify(body),
        method: 'POST',
      },
      callback,
    );
  }

  function getStatistic(callback) {
    const body = {
      customerId: window.adlineConfig.customerId,
      heatmap: {
        ...getHeatMapFilter(),
        url: getUrl()
      },
      tz: getTimezoneOffset(),
    }
    ajax(
      {
        url: window.adlineConfig.heatmapUrl,
        body: JSON.stringify(body),
        method: 'POST',
      },
      callback,
    );
  }

  function getButtonInfo(xpath, callback) {
    const filter = getHeatMapFilter();
    const headers = {authorization: 'Bearer ' + filter.token};
    delete filter.token;
    const dates = [
      {
        startDate: filter.startDate,
        endDate: filter.endDate,
      },
      {
        startDate: filter.prevStartDate,
        endDate: filter.prevEndDate
      }
    ]
    const url = getUrlForTrackingInfo();
    const body = {
      customerId: window.adlineConfig.customerId,
      buttonClicks: dates.map(d => ({
        ...d,
        xpath,
        url
      })),
      uniqueVisitors: dates,
      tz: getTimezoneOffset(),
    }
    ajax(
      {
        url: window.adlineConfig.trackingUrl,
        body: JSON.stringify(body),
        method: 'POST',
        headers
      },
      callback
    );
  }

  function getPageInfo(callback) {
    const filter = getHeatMapFilter();
    const headers = {authorization: 'Bearer ' + filter.token};
    delete filter.token;
    const dates = [
      {
        startDate: filter.startDate,
        endDate: filter.endDate,
      },
      {
        startDate: filter.prevStartDate,
        endDate: filter.prevEndDate
      }
    ];
    const url = getUrlForTrackingInfo();
    const pageDates = dates.map(d => ({
      ...d,
      url
    }));
    const body = {
      customerId: window.adlineConfig.customerId,
      pageDropoff: pageDates,
      pagePerformanceAverageTime: pageDates,
      visits: pageDates,
      uniqueVisitors: pageDates,
      tz: getTimezoneOffset(),
    }
    ajax(
      {
        url: window.adlineConfig.trackingUrl,
        body: JSON.stringify({
          tz: getTimezoneOffset(),
          uniqueVisitors: dates
        }),
        method: 'POST',
        headers,
      },
      res => {
        ajax(
          {
            url: window.adlineConfig.trackingUrl,
            body: JSON.stringify(body),
            method: 'POST',
            headers,
            objToResponse: {
              allUniqueVisitors: res.uniqueVisitors
            }
          },
          callback
        )
      },
    )
  }

  function sendBeaconToServer(body) {
    if (!navigator.sendBeacon || !body.c || !body.sid) {
      return;
    }
    navigator.sendBeacon(
      window.adlineConfig.serverUrl,
      JSON.stringify(body)
    );
  }

  function generateGuid() {
    function s4() {
      return Math.floor((1 + Math.random()) * 0x10000)
        .toString(16)
        .substring(1);
    }

    return s4() + s4() + '-' + s4() + '-' + s4() + '-' + s4() + '-' + s4() + s4() + s4();
  }

  function getUrl() {
    return window.location.href;
  }

  function getUrlForTrackingInfo() {
    return getUrl().replace(/(^\w+:|^)\/\//, '').replace('www.', '');
  }

  function getReferrer() {
    return document.referrer;
  }

  function getAdId() {
    return new URL(getUrl()).searchParams.get('_adlineAdId') || null;
  }

  function getCampaignId() {
    return new URL(getUrl()).searchParams.get('_campaignId') || null;
  }

  function getGclid() {
    return new URL(getUrl()).searchParams.get('gclid') || null;
  }

  function getFbclid() {
    return new URL(getUrl()).searchParams.get('fbclid') || null;
  }

  function getChannelId() {
    return new URL(getUrl()).searchParams.get('_channelId') || null;
  }

  function setStartTime() {
    return window.adlineConfig.startTime = getTime();
  }

  function getVisitorDuration() {
    return getTime() - window.adlineConfig.startTime;
  }

  function getBrowser() {
    return {
      d: getDevice(), // M / D / T
      w: window.screen.width * window.devicePixelRatio,
      h: window.screen.height * window.devicePixelRatio,
      ua: navigator.userAgent,
    };
  }

  function getSessionId(load = false) {
    const sessionId = getCookie('adl_session_id', load);
    if (load) {
      return sessionId || setSessionId();
    }
    return sessionId;
  }

  function setSessionId() {
    const sessionId = generateGuid();
    return setCookie('adl_session_id', sessionId);
  }

  function getVisitorId(load = false) {
    const sessionId = getCookie('adl', load);
    if (load) {
      return sessionId || setVisitorId();
    }
    return sessionId;
  }

  function setVisitorId() {
    const visitorId = generateGuid();
    return setCookie('adl', visitorId);
  }

  function getInitAttr(load = false) {
    const lndcAttr = getCookie('lndcAttr', load);
    if (lndcAttr && typeof lndcAttr === 'string') {
      return setInitAttr();
    }
    return lndcAttr || setInitAttr();
  }

  function hasReferer() {
    const refer = getReferrer();
    if (!refer) {
      return false;
    }
    try {
      const referrerHost = new URL(refer).hostname;
      return !referrerHost.includes(window.adlineConfig.domain.replace(/^\./, ''));
    } catch (e) {
      return false;
    }
  }

  function setInitAttr() {
    const refer = getReferrer();
    const campId = getCampaignId();
    const adId = getAdId();

    let data = {
      campId,
      adId,
      refer,
      chId: getChannelId(),
      url: getUrl(),
      gclid: getGclid(),
      fbclid: getFbclid()
    }

    const hasRef = hasReferer();
    if ((hasRef && campId && adId) || getUrl().includes('utm_source')) {
      setCookie('lndcAttr', data);
      return data;
    } else {
      if (!getCookie('lndcAttr')) {
        setCookie('lndcAttr', data);
        return data;
      }
    }
  }

  function getXPathElement(el) {
    const stack = [];
    while (el.parentNode != null) {
      let sibCount = 1;
      let sibIndex = 0;
      for (let i = 0; i < el.parentNode.childNodes.length; i++) {
        const sib = el.parentNode.childNodes[i];
        if (sib.nodeName === el.nodeName) {
          if (sib === el) {
            sibIndex = sibCount;
          }
          sibCount++;
        }
      }
      if (sibCount > 1) {
        stack.unshift(el.nodeName.toLowerCase() + '[' + sibIndex + ']');
      } else {
        stack.unshift(el.nodeName.toLowerCase());
      }
      el = el.parentNode;
    }
    return '/' + stack.join('/');
  }

  function getCustomerId() {
    return window.adlineConfig.customerId;
  }

  function addDynamicTag(config) {
    const scriptTag = document.createElement(config.name);

    scriptTag.setAttribute('type', 'text/javascript');

    if (config.async) {
      scriptTag.async = true;
    }

    if (config.src) {
      scriptTag.setAttribute('src', config.src);
    }

    if (config.content) {
      const scriptContent = document.createTextNode(config.content);
      scriptTag.appendChild(scriptContent);
    }

    document.getElementsByTagName('head')[0].appendChild(scriptTag);
  }

  function addFacebookMetaTag(config) {
    const metaTag = document.createElement(config.tag);

    if (config.name) {
      metaTag.setAttribute('name', config.name);
    }

    if (config.content) {
      metaTag.setAttribute('content', config.content);
    }

    document.getElementsByTagName('head')[0].appendChild(metaTag);
  }

  function getLoadPayload(url) {
    return {
      e: 'l',
      cid: getCustomerId(),
      c: getVisitorId(true),
      sid: getSessionId(true),
      ts: getTime(),
      tz: getTimezoneOffset(),
      meta: getBrowser(),
      lndcAttr: getInitAttr(true),
      url: url || getUrl(),
      refer: getReferrer(),
      campId: getCampaignId(),
      gclid: getGclid(),
      fbclid: getFbclid(),
      adId: getAdId(),
      chId: getChannelId()
    };
  }

  function getUnloadPayload(url) {
    return {
      e: 'u',
      cid: getCustomerId(),
      c: getVisitorId(),
      sid: getSessionId(),
      ts: getTime(),
      tz: getTimezoneOffset(),
      meta: getBrowser(),
      dur: getVisitorDuration(),
      lndcAttr: getInitAttr(),
      url: url || getUrl(),
      refer: getReferrer(),
      campId: getCampaignId(),
      gclid: getGclid(),
      fbclid: getFbclid(),
      adId: getAdId(),
      chId: getChannelId()
    };
  }

  function sendLoad(url = null) {
    if (getHeatMapFilter()) {
      return;
    }

    setStartTime();
    setInitAttr();

    const payload = getLoadPayload(url);
    sendToServer(payload);
  }

  function sendUnLoad(url = null) {
    if (getHeatMapFilter()) {
      return;
    }

    const payload = getUnloadPayload(url);
    sendBeaconToServer(payload);
  }

  function createElement(tag, clas) {
    const el = document.createElement(tag);
    el.className = clas;
    return el
  }

  function secondsToStringTime(inputSeconds) {
    const days = Math.floor(inputSeconds / (60 * 60 * 24));
    const hour = Math.floor((inputSeconds % (60 * 60 * 24)) / (60 * 60));
    const minutes = Math.floor(
      ((inputSeconds % (60 * 60 * 24)) % (60 * 60)) / 60
    );
    const seconds = Math.floor(
      ((inputSeconds % (60 * 60 * 24)) % (60 * 60)) % 60
    );
    let ddhhmmss = '';
    if (days > 0) {
      ddhhmmss += days + (days === 1 ? ' Day ' : ' Days ');
    }
    if (hour > 0) {
      ddhhmmss += hour + 'h, ';
    }

    if (minutes > 0) {
      ddhhmmss += minutes + ' min, ';
    }

    if (seconds > 0) {
      ddhhmmss += seconds + ' sec';
    }
    return ddhhmmss || '0';
  }

  function setLoadingHtml() {
    return '<div style="color: #000; font-size: 14px;">Loading...</div>';
  }

  window.adlineConfig.helpers = {
    getUrl: getUrl,
    getUrlForTrackingInfo: getUrlForTrackingInfo,
    getSessionId: getSessionId,
    getVisitorId: getVisitorId,
    getXPathElement: getXPathElement,
    getCustomerId: getCustomerId,
    addDynamicTag: addDynamicTag,
    addFacebookMetaTag: addFacebookMetaTag,
    getTime: getTime,
    getTimezoneOffset: getTimezoneOffset,
    sendLoad: sendLoad,
    sendUnLoad: sendUnLoad,
    getInitAttr: getInitAttr,
    getCampaignId: getCampaignId,
    getGclid: getGclid,
    getFbclid: getFbclid,
    getAdId: getAdId,
    getChannelId: getChannelId,
    sendBeaconToServer: sendBeaconToServer,
    getStatistic: getStatistic,
    getButtonInfo: getButtonInfo,
    getPageInfo: getPageInfo,
    getConversion: getConversion,
    getDateToString: getDateToString,
    getHeatMapFilter: getHeatMapFilter,
    checkStepTransitions: checkStepTransitions,
    getBrowser: getBrowser,
    createElement: createElement,
    secondsToStringTime: secondsToStringTime,
    setLoadingHtml: setLoadingHtml,
  };
})(window);

(function detectClickMap(window, document) {
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('startDate') && urlParams.get('endDate') && urlParams.get('adl_heat_map') && urlParams.get('adl_key')) {
    sessionStorage.setItem('adl_heat_map', JSON.stringify({
      startDate: urlParams.get('startDate'),
      endDate: urlParams.get('endDate'),
      prevStartDate: urlParams.get('prevStartDate'),
      prevEndDate: urlParams.get('prevEndDate'),
      granularity: urlParams.get('granularity'),
      period: urlParams.get('period'),
      value: urlParams.get('value'),
      cst: urlParams.get('cst'),
      token: urlParams.get('adl_key'),
      appsumo: urlParams.get('appsumo'),
    }))

    urlParams.delete('adl_heat_map');
    urlParams.delete('startDate');
    urlParams.delete('endDate');
    urlParams.delete('prevStartDate');
    urlParams.delete('prevEndDate');
    urlParams.delete('granularity');
    urlParams.delete('period');
    urlParams.delete('value');
    urlParams.delete('cst');
    urlParams.delete('adl_key');
    urlParams.delete('appsumo');

    window.history.replaceState({}, document.title, window.location.pathname + (!!urlParams.toString() ? '?' + urlParams.toString() : ''));
    window.adlineConfig.clickMapMode = true;
  } else {
    if (window.adlineConfig.helpers.getHeatMapFilter()) {
      window.adlineConfig.clickMapMode = true
    }
  }
})(window, document);

(function runClickMap(window, document) {
  if (window.adlineConfig.clickMapMode) {
    (function clickMapStyles(document) {
      const style = document.createElement('style');
      style.innerHTML = `.adl-pulse {
      display: inline-block;
      text-decoration: none;
      cursor: pointer;
      z-index: 1000;
      position: absolute;
      left: 50%;
      top: 50%;
      margin-right: -50%;
      transform: translate(-50%, -50%);
    }

    .adl-pulse-content {
      background: #6F00FF;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      color: #FFF;
      text-align: center;
      line-height: 20px;
      font-family: sans-serif;
      text-transform: uppercase;
      padding: 5px;
      animation: animate-adl-pulse 3s linear infinite;
      opacity: 0.7;
    }

    @import url('https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap');

    .adlmodal-btn, .adlmodal-page {
      background-color: #FFFFFF;
      padding: 30px;
      border-radius: 12px;
      box-shadow: -8px 28px 48px 0 rgba(0,0,0,0.19);
      display: none;
      position: fixed;
      z-index: 1500;
    }

    .adlmodal-btn *, .adlmodal-page * {
      font-family: 'Roboto', sans-serif;
      font-weight: 300;
      box-sizing: border-box;
    }

    .adlmodal_title {
      color: #000;
      font-weight: 500;
      font-size: 24px;
      margin-bottom: 20px;
    }

    .adlmodal_c {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .adlmodal_c_period {
      color: #6F00FF;
      margin-bottom: 30px;
      font-size: 16px;
    }

    .adlmodal_action {
      text-align: center;
      padding-top: 15px;
    }

    .adlmodal_action a {
      text-decoration: none;
      display: inline-block;
      font-size: 14px;
      color: #6F00FF;
      border: 1px solid #000;
      border-radius: 4px;
      padding: 12px 20px;
    }

    .adlmodal_c_info {
      display: flex;
      align-items: center;
      margin-bottom: 30px;
    }
    
    .adlmodal_p_info {
      display: grid;
      grid-template-columns: 50px auto;
      column-gap: 20px;
      align-items: center;
      margin-bottom: 30px;
    }

    .adlmodal_p_info > *:first-child {
      text-align: center;
    }

    .adlmodal_c_data {
      margin-left: 20px;
    }

    .adlmodal_c_value {
      font-size: 20px;
      font-weight: 400;
      color: #000;
    }

    .adlmodal_c_title {
      font-size: 14px;
      color: #000;
    }

    .adlmodal_f_separator {
      height: 140px;
      margin: 0 20px 20px;
      display: flex;
      align-items: center;
    }

    .adlmodal_f_separator.page-info-separator {
      height: 260px;
    }

    .adlmodal_separator {
      color: #6F00FF;
      font-size: 14px;
      width: 21px;
      height: 21px;
      border: 1px solid #6F00FF;
      border-radius: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      position: relative;
    }

    .adlmodal_separator:before,
    .adlmodal_separator:after {
      content: '';
      position: absolute;
      left: 10px;
      width: 1px;
      height: 55px;
      background-color: #6F00FF;
    }

    .page-info-separator .adlmodal_separator:before,
    .page-info-separator .adlmodal_separator:after {
      height: 115px;
    }

    .adlmodal_separator:before {
      bottom: 24px;
    }

    .adlmodal_separator:after {
      top: 24px;
    }

    @keyframes animate-adl-pulse {
      0% {
        box-shadow: 0 0 0 0 rgba(171, 85, 255, 0.7), 0 0 0 0 rgba(171, 85, 255, 0.7);
      }
      40% {
        box-shadow: 0 0 0 15px rgba(255, 109, 74, 0.0), 0 0 0 0 rgba(171, 85, 255, 0.7);
      }
      80% {
        box-shadow: 0 0 0 15px rgba(255, 109, 74, 0.0), 0 0 0 15px rgba(255, 109, 74, 0);
      }
      100% {
        box-shadow: 0 0 0 0 rgba(255, 109, 74, 0.0), 0 0 0 15px rgba(255, 109, 74, 0);
      }
    }

    .click-map-window-frame {
      position: fixed;
      z-index: 1100;
      left: 0;
      top: 0;
      width: 100vw;
      height: 100vh;
      background-color: rgba(0, 0, 0, .3);
      box-sizing: border-box;
    }

    .click-map-window-modal {
      position: absolute;
      width: 520px;
      padding: 40px;
      border-radius: 12px;
      background-color: #fff;
      box-shadow: inset 0 1px 0 rgba(254, 255, 255, 0.6), 0 10px 19px -3px rgba(0, 0, 0, .7), 0 0 0 1px rgb(0, 0, 0, 0);
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
    }

    .click-map-window-modal * {
      font-family: 'Roboto', sans-serif;
      font-weight: 400;
    }

    .click-map-window-modal h1 {
      font-size: 24px;
      margin-bottom: 30px;
      font-weight: 600;
      text-align: center;
    }

    .click-map-window-modal p {
      font-size: 16px;
      margin-bottom: 30px;
    }

    .click-map-window-modal .click-map-actions {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .click-map-window-modal button, .click-map-window-modal a {
      margin: 0 15px;
      display: inline-block;
      background-color: transparent;
      text-decoration: none;
      font-size: 16px;
      height: 45px;
      line-height: 45px;
      padding: 0 30px;
      border-radius: 4px;
      cursor: pointer;
    }

    .click-map-window-modal button {
      background-color: #ffffff;
      color: #000000;
      box-shadow: none;
      border: 1px solid #7e84a3;
    }

    .click-map-window-modal a {
      background-color: #6F00FF;
      color: #ffffff;
    }

    .frame-info-page-button {
      background-color: rgba(48, 49, 65, 0.69);
      padding: 16px;
      position: fixed;
      right: 0;
      top: calc(50% - 25px);
      z-index: 1100;
    }

    .info-page-button {
      display: inline-block;
      background-color: transparent;
      text-decoration: none;
      font-size: 18px;
      height: 49px;
      line-height: 49px;
      padding: 0 15px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 500;
      border: 1px solid #fff;
      color: #fff;
      font-family: 'Roboto', sans-serif;
      transition: background-color 0.2s;
    }
    .info-page-button:hover {
      background-color: rgba(48, 49, 65, 0.69);
    }
    `;
      document.head.appendChild(style);
    })(document);

    (function domChangeEvent(window) {
      let last = +new Date();
      let delay = 100; // default delay

      // Manage event queue
      const stack = [];

      function callback() {
        const now = +new Date();
        if (now - last > delay) {
          for (let i = 0; i < stack.length; i++) {
            stack[i]();
          }
          last = now;
        }
      }

      // Public interface
      const onDomChange = function (fn, newdelay) {
        if (newdelay) delay = newdelay;
        stack.push(fn);
      };
      const support = {};

      const el = window.document.documentElement;
      let remain = 3;

      // callback for the tests
      function decide() {
        if (support.DOMNodeInserted) {
          window.addEventListener(
            'DOMContentLoaded',
            function () {
              if (support.DOMSubtreeModified) {
                // for FF 3+, Chrome
                el.addEventListener('DOMSubtreeModified', callback, false);
              } else {
                // for FF 2, Safari, Opera 9.6+
                el.addEventListener('DOMNodeInserted', callback, false);
                el.addEventListener('DOMNodeRemoved', callback, false);
              }
            },
            false
          );
        }
      }

      // checks a particular event
      function test(event) {
        el.addEventListener(
          event,
          function fn() {
            support[event] = true;
            el.removeEventListener(event, fn, false);
            if (--remain === 0) {
              decide();
            }
          },
          false
        );
      }

      // attach test events
      if (window.addEventListener) {
        test('DOMSubtreeModified');
        test('DOMNodeInserted');
        test('DOMNodeRemoved');
      } else {
        decide();
      }

      window.onDomChange = onDomChange;
    })(window);

    (function generateHeatMap(window, document) {
      const helpers = window.adlineConfig.helpers
      window.adlineConfig.generatedElements = new Set()

      function getElementByXpath(path) {
        return document.evaluate(
          path,
          document,
          null,
          XPathResult.FIRST_ORDERED_NODE_TYPE,
          null
        ).singleNodeValue;
      }

      document.querySelector('html').appendChild(helpers.createElement('div', 'adlmodal-btn'));
      document.querySelector('html').appendChild(helpers.createElement('div', 'adlmodal-page'));

      const maxSize = 70;

      helpers.getStatistic((res) => {
        try {
          const elements = (res.heatmap || []).sort((a, b) => +b.clicks - +a.clicks);
          const oneItemCost = maxSize / +elements[0].clicks;

          function configurePulse() {
            elements.forEach((e) => {
              if (e.xpath && !window.adlineConfig.generatedElements.has(e.xpath)) {
                const pulse = helpers.createElement('span', 'adl-pulse');
                const pulseContent = helpers.createElement('span', 'adl-pulse-content');

                pulseContent.setAttribute('data-click', +e.clicks);
                pulseContent.setAttribute('data-xpath', e.xpath);
                pulseContent.setAttribute('data-name', e.name);
                const pulseSize = Math.ceil(oneItemCost * +e.clicks);
                pulseContent.style.width = pulseSize + 'px';
                pulseContent.style.height = pulseSize + 'px';
                pulse.appendChild(pulseContent);

                try {
                  const elem = getElementByXpath(e.xpath)

                  if (elem) {
                    window.adlineConfig.generatedElements.add(e.xpath);

                    if (elem.style.position !== 'fixed' && elem.style.position !== 'relative' && elem.style.position !== 'absolute') {
                      elem.style.position = 'relative';
                    }

                    elem.appendChild(pulse);
                  }
                } catch (e) {
                  console.log(e);
                }
              }
            });
          }

          configurePulse();
          onDomChange(() => {
            configurePulse();
          });
        } catch (e) {
          console.log(e);
        }
      });

      window.addEventListener('onurlchanged', function (e) {
        window.adlineConfig.generatedElements.clear();
      });

    })(window, document);

    (function showInfoBubble(window, document) {
