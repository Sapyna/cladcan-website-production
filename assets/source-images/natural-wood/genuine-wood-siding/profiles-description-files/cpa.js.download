                    <div>
                      ${percent}
                    </div>
                    <div class="adlmodal_c_data">
                      <div class="adlmodal_c_value">${prevConv}%</div>
                      <div class="adlmodal_c_title">Conversion rate</div>
                    </div>
                  </div>
                </div>

                <div class="adlmodal_f_separator">
                  <div class="adlmodal_separator">
                    vs
                  </div>
                </div>

                <div>
                  <div class="adlmodal_c_period">${currPeriod}</div>
                  <div class="adlmodal_c_info">
                    <div>
                       ${mouse}
                    </div>
                    <div class="adlmodal_c_data">
                      <div class="adlmodal_c_value">${currClicks}</div>
                      <div class="adlmodal_c_title">Clicks</div>
                    </div>
                  </div>
                  <div class="adlmodal_c_info">
                    <div>
                      ${percent}
                    </div>
                    <div class="adlmodal_c_data">
                      <div class="adlmodal_c_value">${currConv}%</div>
                      <div class="adlmodal_c_title">Conversion rate</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="adlmodal_action">
                <a href="${window.adlineConfig.clientProdUrl}tracking/buttons?buttonName=${name}&startDate=${filter.startDate}&endDate=${filter.endDate}&value=${filter.value}&granularity=${filter.granularity}&period=${filter.period}" target="_blank">See more</a>
              </div>
            </div>`;
      }

      function setPreviewPosition(preview, adlPulse) {
        if (preview) {
          preview.style.opacity = 0;
          preview.style.display = 'inline-block';

          const {offsetWidth, offsetHeight} = preview;
          const {height, width, top, left, right} = adlPulse.getBoundingClientRect();

          preview.style.top = top - offsetHeight - 3 + 'px';
          preview.style.left = left - offsetWidth / 2 + width / 2 + 'px';
          preview.style.right = 'auto';

          if ((offsetWidth / 2) > (left + width / 2)) {
            preview.style.left = '0px';
          } else if (offsetWidth / 2 + (left + width / 2) > window.innerWidth) {
            preview.style.left = 'auto';
            preview.style.right = '0px';
          }

          if (offsetHeight > top) {
            preview.style.top = height + top + 3 + 'px';
          }

          preview.style.opacity = 1;
        }
      }

      document.addEventListener('mouseover', (ev) => {
        let el = ev.target;
        const adlPulse = el.getAttribute('class') === 'adl-pulse-content' ? el : null
        if (adlPulse) {
          const preview = document.querySelector('.adlmodal-btn');
          const xpath = el.getAttribute('data-xpath');
          const name = el.getAttribute('data-name');

          setPreviewPosition(preview, adlPulse);

          preview.innerHTML = helpers.setLoadingHtml();
          setPreviewPosition(preview, adlPulse);

          helpers.getButtonInfo(xpath, (res) => {
            const currClicks = res.buttonClicks[0] || 0;
            const currConv = helpers.getConversion(
              res.buttonClicks[0] || 0,
              res.uniqueVisitors[0] || 0
            );
            const prevClicks = res.buttonClicks[1] || 0;
            const prevConv = helpers.getConversion(
              res.buttonClicks[1] || 0,
              res.uniqueVisitors[1] || 0
            );
            preview.innerHTML = getButtonInfoTemplate(name, prevClicks, prevConv, currClicks, currConv);
            setPreviewPosition(preview, adlPulse);
          })
        }
      })

      document.addEventListener('mouseout', (ev) => {
        const el = ev.target;
        const adlPulse = el.getAttribute('class') === 'adl-pulse-content' ? el : null
        if (adlPulse) {
          setTimeout(() => {
            const tooltip = [...document.querySelectorAll(':hover')].filter(n => n.getAttribute('class') === 'adlmodal-btn').length;
            if (!tooltip) {
              const preview = document.querySelector('.adlmodal-btn');
              preview.style.opacity = 0;
              preview.style.display = 'none';
            }
          }, 300)
        }
      });

      const tooltipMouseout = () => {
        try {
          document.querySelector('.adlmodal-btn').addEventListener('mouseleave', (ev) => {
            const el = ev.target;
            el.style.opacity = 0;
            el.style.display = 'none';
          });
        } catch (e) {
          setTimeout(() => {
            tooltipMouseout();
          }, 500)
        }
      }

      tooltipMouseout();
    })(window, document);

