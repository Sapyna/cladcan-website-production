                            <g transform="translate(843.003906, 459.037109)">
                              <path
                                d="M0,8.11008468 C0,5.79291763 0.700538876,3.86194509 2.10161663,2.31716705 C3.50269438,0.772389017 5.2450603,0 7.3287144,0 C9.43033102,0 11.1726969,0.776879651 12.5558122,2.33063895 C13.9389274,3.88439826 14.630485,5.8557865 14.630485,8.2448037 L14.630485,10.1847575 C14.630485,12.4659995 13.943418,14.3790095 12.5692841,15.9237875 C11.1951501,17.4685656 9.46625609,18.2409546 7.382602,18.2409546 C5.28098537,18.2409546 3.52514755,17.4775468 2.11508853,15.9507313 C0.70502951,14.4239158 0,12.448037 0,10.0230947 L0,8.11008468 Z M1.48190916,10.1847575 C1.48190916,12.0528612 2.01629459,13.6156017 3.08506543,14.8729792 C4.15383628,16.1303567 5.58634847,16.7590454 7.382602,16.7590454 C9.10700539,16.7590454 10.4991019,16.139338 11.5588915,14.899923 C12.618681,13.6605081 13.1485758,12.0438799 13.1485758,10.0500385 L13.1485758,8.11008468 C13.1485758,6.17013087 12.6141904,4.5804465 11.5454196,3.34103156 C10.4766487,2.10161663 9.07108032,1.48190916 7.3287144,1.48190916 C5.62227354,1.48190916 4.22119579,2.10161663 3.12548114,3.34103156 C2.02976649,4.5804465 1.48190916,6.23299974 1.48190916,8.2986913 L1.48190916,10.1847575 Z M20.369515,30.1770593 C20.369515,27.8598922 21.0655633,25.9334103 22.4576597,24.3976135 C23.8497562,22.8618168 25.5876315,22.0939184 27.6712856,22.0939184 C29.7729022,22.0939184 31.5197588,22.8618168 32.9118553,24.3976135 C34.3039518,25.9334103 35,27.9227611 35,30.3656659 L35,32.2786759 C35,34.595843 34.3039518,36.5223249 32.9118553,38.0581216 C31.5197588,39.5939184 29.7908648,40.3618168 27.7251732,40.3618168 C25.6415191,40.3618168 23.8946626,39.598409 22.4846035,38.0715935 C21.0745445,36.544778 20.369515,34.5688992 20.369515,32.1439569 L20.369515,30.1770593 Z M21.8514242,32.2786759 C21.8514242,34.2006672 22.3858096,35.7813703 23.4545804,37.0207852 C24.5233513,38.2602002 25.9468822,38.8799076 27.7251732,38.8799076 C29.4855017,38.8799076 30.8910701,38.2557095 31.9418784,37.0073133 C32.9926867,35.7589171 33.5180908,34.1377983 33.5180908,32.1439569 L33.5180908,30.1770593 C33.5180908,28.1472928 32.9926867,26.5396459 31.9418784,25.3541186 C30.8910701,24.1685912 29.4675391,23.5758276 27.6712856,23.5758276 C25.8929946,23.5758276 24.478445,24.1820631 23.4276366,25.3945343 C22.3768283,26.6070054 21.8514242,28.2371055 21.8514242,30.2848345 L21.8514242,32.2786759 Z M8.2986913,36.2663587 L7.08622017,35.4311008 L26.243264,4.76905312 L27.4557352,5.60431101 L8.2986913,36.2663587 Z"
