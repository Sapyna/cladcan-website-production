# Google Workspace email used by the website forms.
# Copy this file to .env.local and replace the placeholder values locally.
# Never commit .env.local.

GOOGLE_WORKSPACE_EMAIL=info@cladca.ca
GOOGLE_APP_PASSWORD=replace-with-google-app-password

# Optional overrides. The forms default to smtp.gmail.com:587 and info@cladca.ca.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# CONTACT_FROM_EMAIL=info@cladca.ca
# CONTACT_TO_EMAIL=info@cladca.ca


# Google Business Profile API (required to load every live review).
# Create OAuth 2.0 credentials with the business.manage scope and store the
# resulting refresh token in the deployment environment.
GOOGLE_BUSINESS_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_BUSINESS_CLIENT_SECRET=replace-with-oauth-client-secret
GOOGLE_BUSINESS_REFRESH_TOKEN=replace-with-oauth-refresh-token
